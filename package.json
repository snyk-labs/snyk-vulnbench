{
  "name": "coding-agent-security-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "echo 'Use: pnpm run benchmark'",
    "benchmark": "tsx src/index.ts --repetitions 1",
    "benchmark:find": "tsx src/index.ts --category find-vulns --repetitions 1",
    "benchmark:find:js": "tsx src/index.ts --task js-project-tigerteam-find-vulns --config sonnet-4-6 --repetitions 1",
    "benchmark:find:js-1-2": "tsx src/index.ts --task js-project-tigerteam-find-vulns,js-project-shadowfox-find-vulns --config sonnet-4-6 --repetitions 1",
    "benchmark:find:js-1-2-with-snyk": "tsx src/index.ts --task js-project-tigerteam-find-vulns,js-project-shadowfox-find-vulns --config sonnet-4-6,snyk-code --repetitions 1",
    "benchmark:fix": "tsx src/index.ts --category fix-vulns --repetitions 1",
    "report:serve": "serve",
    "//report:serve example": "pnpm report:serve public/2026-05-14-wpq2k"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.84",
    "@anthropic-ai/sdk": "^0.80.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "serve": "14.2.6",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
